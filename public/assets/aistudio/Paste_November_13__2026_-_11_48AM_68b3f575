<script>
  // Dynamic Map Layer Toggles for Interactive Feel
  const topoBtn = document.getElementById('toggle-topo');
  const satBtn = document.getElementById('toggle-sat');
  const threeDBtn = document.getElementById('toggle-3d');
  const modal3D = document.getElementById('terrain-3d-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const closeModalMainBtn = document.getElementById('btn-modal-close-main');

  if (topoBtn && satBtn) {
    topoBtn.addEventListener('click', () => {
      topoBtn.classList.toggle('bg-surface-container-highest');
      topoBtn.classList.toggle('text-secondary');
    });

    satBtn.addEventListener('click', () => {
      satBtn.classList.toggle('bg-surface-container-highest');
      satBtn.classList.toggle('text-secondary');
    });
  }

  // --- Interactive 3D Terrain Preview Modal Engine ---
  function openTerrainModal() {
    if (!modal3D) return;
    modal3D.classList.remove('hidden');
    initTerrainCanvas();
    if (threeDBtn) {
      threeDBtn.classList.add('bg-tertiary/20', 'text-tertiary');
    }
  }

  function closeTerrainModal() {
    if (!modal3D) return;
    modal3D.classList.add('hidden');
    if (autoOrbitInterval) {
      cancelAnimationFrame(autoOrbitInterval);
      autoOrbitInterval = null;
    }
  }

  if (threeDBtn) {
    threeDBtn.addEventListener('click', openTerrainModal);
  }
  if (closeModalBtn) {
    closeModalBtn.addEventListener('click', closeTerrainModal);
  }
  if (closeModalMainBtn) {
    closeModalMainBtn.addEventListener('click', closeTerrainModal);
  }

  // Close with ESC or background click
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal3D && !modal3D.classList.contains('hidden')) {
      closeTerrainModal();
    } else if (e.key === '3' && modal3D && modal3D.classList.contains('hidden')) {
      openTerrainModal();
    }
  });

  if (modal3D) {
    modal3D.addEventListener('click', (e) => {
      if (e.target === modal3D) {
        closeTerrainModal();
      }
    });
  }

  // --- HTML5 Canvas Interactive 3D Terrain Renderer ---
  const canvas = document.getElementById('terrain-canvas');
  let ctx = canvas ? canvas.getContext('2d') : null;

  // 3D Camera / Orbit State
  let yaw = -0.75; // radians ~ -43 deg
  let pitch = 0.55; // radians ~ 31 deg
  let zoom = 1.05;
  let isDragging = false;
  let lastMouseX = 0;
  let lastMouseY = 0;
  let autoOrbit = true;
  let autoOrbitInterval = null;

  // Shader / Render options
  let showWireframe = true;
  let showShaded = true;
  let showContours = true;
  let showFog = true;
  let sunAzimuth = 0.82; // 0 to 1

  // Waypoints Database in 3D Grid Space [-1..1]
  const waypoints = [
    { id: 0, name: "Start: El Chaltén", elev: "420m ASL", incline: "3.2%", temp: "11.2°C", o2: "96.2%", coords: "49°19'50\"S 72°53'10\"W", dist: "0.0 km", status: "TRAVERSED", gx: -0.68, gz: 0.65, color: "#4edea3" },
    { id: 1, name: "Mirador Capri", elev: "780m ASL", incline: "8.5%", temp: "9.8°C", o2: "93.4%", coords: "49°18'32\"S 72°55'40\"W", dist: "4.8 km", status: "PASSED", gx: -0.32, gz: 0.28, color: "#4edea3" },
    { id: 2, name: "Poincenot Camp (Active)", elev: "1,120m ASL", incline: "14.2%", temp: "6.4°C", o2: "88.5%", coords: "49°17'12\"S 72°58'45\"W", dist: "12.3 km", status: "LIVE BEACON", gx: 0.05, gz: -0.05, color: "#ff5a1f", isLive: true },
    { id: 3, name: "Ridge Pass Step", elev: "1,840m ASL", incline: "24.6%", temp: "3.1°C", o2: "81.0%", coords: "49°16'28\"S 73°01'15\"W", dist: "17.6 km", status: "PENDING", gx: 0.42, gz: -0.40, color: "#ab897f" },
    { id: 4, name: "Laguna de los Tres", elev: "2,140m ASL", incline: "28.0%", temp: "0.8°C", o2: "77.5%", coords: "49°15'44\"S 73°02'30\"W", dist: "21.4 km", status: "DESTINATION", gx: 0.68, gz: -0.62, color: "#7bd0ff" }
  ];

  let activeWp = waypoints[2];

  // Grid definition
  const GRID_SIZE = 28; // 28x28 vertices
  let terrainGrid = [];

  function generateTerrainGrid() {
    terrainGrid = [];
    for (let r = 0; r <= GRID_SIZE; r++) {
      let row = [];
      let zNorm = (r / GRID_SIZE) * 2 - 1; // -1 to 1
      for (let c = 0; c <= GRID_SIZE; c++) {
        let xNorm = (c / GRID_SIZE) * 2 - 1; // -1 to 1

        // Base mountain slope from bottom-left to top-right (Fitz Roy Range)
        let baseElev = (xNorm - zNorm) * 0.35 + 0.1;

        // Summit spires (Mt Fitz Roy and Poincenot aiguilles) around (0.5, -0.6)
        let distSummit = Math.hypot(xNorm - 0.55, zNorm + 0.58);
        let summitSpire = Math.exp(-distSummit * 4.2) * 1.35;

        // Secondary ridge (Sentinel Pass) around (0.1, -0.2)
        let distRidge = Math.hypot(xNorm - 0.1, zNorm + 0.15);
        let ridge = Math.exp(-distRidge * 3.5) * 0.65;

        // Valley lake depression (Laguna de los Tres) around (0.65, -0.4)
        let distLake = Math.hypot(xNorm - 0.68, zNorm + 0.38);
        let lakeDip = Math.exp(-distLake * 6.0) * -0.22;

        // Rough terrain harmonics
        let noise = Math.sin(xNorm * 7.5) * Math.cos(zNorm * 7.5) * 0.08 +
                    Math.sin(xNorm * 15.0 + zNorm * 11.0) * 0.035;

        let height = Math.max(0.05, baseElev + summitSpire + ridge + lakeDip + noise);
        row.push({ x: xNorm, z: zNorm, y: height });
      }
      terrainGrid.push(row);
    }
  }

  function getTerrainHeightAt(xNorm, zNorm) {
    let r = Math.min(GRID_SIZE - 1, Math.max(0, Math.floor(((zNorm + 1) / 2) * GRID_SIZE)));
    let c = Math.min(GRID_SIZE - 1, Math.max(0, Math.floor(((xNorm + 1) / 2) * GRID_SIZE)));
    return terrainGrid[r] && terrainGrid[r][c] ? terrainGrid[r][c].y : 0.4;
  }

  function project3D(x, y, z, width, height) {
    // Rotate around Y (Yaw)
    let cosY = Math.cos(yaw);
    let sinY = Math.sin(yaw);
    let x1 = x * cosY - z * sinY;
    let z1 = x * sinY + z * cosY;

    // Rotate around X (Pitch)
    let cosP = Math.cos(pitch);
    let sinP = Math.sin(pitch);
    let y2 = y * cosP - z1 * sinP;
    let z2 = y * sinP + z1 * cosP;

    // Perspective isometric projection
    let scale = (width * 0.42 * zoom) / (z2 + 2.4);
    let px = width / 2 + x1 * scale;
    let py = height / 2 - y2 * scale + height * 0.1;

    return { x: px, y: py, depth: z2 };
  }

  function drawTerrain() {
    if (!canvas || !ctx || modal3D.classList.contains('hidden')) return;

    const rect = canvas.getBoundingClientRect();
    if (canvas.width !== rect.width || canvas.height !== rect.height) {
      canvas.width = rect.width;
      canvas.height = rect.height;
    }

    const W = canvas.width;
    const H = canvas.height;
    ctx.clearRect(0, 0, W, H);

    // Subtle tactical background star/grid dots
    ctx.strokeStyle = "rgba(41, 59, 54, 0.4)";
    ctx.lineWidth = 0.5;
    const step = 60;
    for (let x = 0; x < W; x += step) {
      for (let y = 0; y < H; y += step) {
        ctx.fillStyle = "rgba(78, 222, 163, 0.12)";
        ctx.fillRect(x, y, 1.5, 1.5);
      }
    }

    // Light direction vector based on sunAzimuth
    let sunAngle = (sunAzimuth - 0.5) * Math.PI;
    let lx = Math.cos(sunAngle);
    let ly = Math.sin(pitch) * 0.8 + 0.4;
    let lz = Math.sin(sunAngle);
    let lLen = Math.hypot(lx, ly, lz);
    lx /= lLen; ly /= lLen; lz /= lLen;

    // Collect and sort polygons for depth painters algorithm
    let quads = [];
    for (let r = 0; r < GRID_SIZE; r++) {
      for (let c = 0; c < GRID_SIZE; c++) {
        let v00 = terrainGrid[r][c];
        let v10 = terrainGrid[r + 1][c];
        let v11 = terrainGrid[r + 1][c + 1];
        let v01 = terrainGrid[r][c + 1];

        let p00 = project3D(v00.x, v00.y, v00.z, W, H);
        let p10 = project3D(v10.x, v10.y, v10.z, W, H);
        let p11 = project3D(v11.x, v11.y, v11.z, W, H);
        let p01 = project3D(v01.x, v01.y, v01.z, W, H);

        let avgDepth = (p00.depth + p10.depth + p11.depth + p01.depth) / 4;
        let avgHeight = (v00.y + v10.y + v11.y + v01.y) / 4;

        // Approximate normal for lighting
        let nx = (v00.y - v01.y) * 2;
        let ny = 0.35;
        let nz = (v00.y - v10.y) * 2;
        let nLen = Math.hypot(nx, ny, nz) || 1;
        nx /= nLen; ny /= nLen; nz /= nLen;
        let diffuse = Math.max(0.12, (nx * lx + ny * ly + nz * lz));

        quads.push({
          pts: [p00, p10, p11, p01],
          depth: avgDepth,
          height: avgHeight,
          light: diffuse,
          r: r,
          c: c
        });
      }
    }

    // Sort by depth back-to-front
    quads.sort((a, b) => b.depth - a.depth);

    // Draw terrain faces
    for (let q of quads) {
      ctx.beginPath();
      ctx.moveTo(q.pts[0].x, q.pts[0].y);
      ctx.lineTo(q.pts[1].x, q.pts[1].y);
      ctx.lineTo(q.pts[2].x, q.pts[2].y);
      ctx.lineTo(q.pts[3].x, q.pts[3].y);
      ctx.closePath();

      if (showShaded) {
        // Gradient color from valley emerald -> scree stone -> summit peak orange
        let normH = Math.min(1.2, Math.max(0, q.height));
        let baseR, baseG, baseB;
        if (normH < 0.4) {
          // Deep emerald valley
          baseR = 10; baseG = 45; baseB = 34;
        } else if (normH < 0.8) {
          // Alpine slate / scree
          baseR = 35; baseG = 58; baseB = 52;
        } else if (normH < 1.1) {
          // High rock ridge
          baseR = 85; baseG = 65; baseB = 50;
        } else {
          // Summit needle orange accent
          baseR = 210; baseG = 85; baseB = 40;
        }

        let litR = Math.floor(baseR * q.light * 1.6);
        let litG = Math.floor(baseG * q.light * 1.6);
        let litB = Math.floor(baseB * q.light * 1.6);
        let alpha = showFog ? Math.max(0.4, Math.min(0.96, 1.3 - (q.depth + 1.2) * 0.3)) : 0.95;

        ctx.fillStyle = `rgba(${litR}, ${litG}, ${litB}, ${alpha})`;
        ctx.fill();
      }

      if (showWireframe) {
        let wireAlpha = 0.22;
        if (showContours && Math.abs((q.height * 10) % 1) < 0.25) {
          // Highlight contour band
          ctx.strokeStyle = `rgba(123, 208, 255, 0.45)`;
          ctx.lineWidth = 1.0;
        } else {
          ctx.strokeStyle = `rgba(78, 222, 163, ${wireAlpha})`;
          ctx.lineWidth = 0.5;
        }
        ctx.stroke();
      }
    }

    // Draw 3D Route Trail Trace on the mountain mesh
    let routeNodes = [
      { gx: -0.68, gz: 0.65 },
      { gx: -0.52, gz: 0.48 },
      { gx: -0.32, gz: 0.28 },
      { gx: -0.12, gz: 0.12 },
      { gx: 0.05, gz: -0.05 },
      { gx: 0.24, gz: -0.22 },
      { gx: 0.42, gz: -0.40 },
      { gx: 0.55, gz: -0.52 },
      { gx: 0.68, gz: -0.62 }
    ];

    ctx.beginPath();
    for (let i = 0; i < routeNodes.length; i++) {
      let rNode = routeNodes[i];
      let h = getTerrainHeightAt(rNode.gx, rNode.gz) + 0.03;
      let pt = project3D(rNode.gx, h, rNode.gz, W, H);
      if (i === 0) ctx.moveTo(pt.x, pt.y);
      else ctx.lineTo(pt.x, pt.y);
    }
    // Glow underlay
    ctx.strokeStyle = "rgba(255, 90, 31, 0.35)";
    ctx.lineWidth = 6;
    ctx.lineCap = "round";
    ctx.lineJoin = "round";
    ctx.stroke();

    // Main route vector (completed emerald, pending dash orange)
    ctx.beginPath();
    for (let i = 0; i <= 4; i++) {
      let rNode = routeNodes[i];
      let h = getTerrainHeightAt(rNode.gx, rNode.gz) + 0.03;
      let pt = project3D(rNode.gx, h, rNode.gz, W, H);
      if (i === 0) ctx.moveTo(pt.x, pt.y);
      else ctx.lineTo(pt.x, pt.y);
    }
    ctx.strokeStyle = "#4edea3";
    ctx.lineWidth = 3;
    ctx.stroke();

    // Remaining segment
    ctx.beginPath();
    for (let i = 4; i < routeNodes.length; i++) {
      let rNode = routeNodes[i];
      let h = getTerrainHeightAt(rNode.gx, rNode.gz) + 0.03;
      let pt = project3D(rNode.gx, h, rNode.gz, W, H);
      if (i === 4) ctx.moveTo(pt.x, pt.y);
      else ctx.lineTo(pt.x, pt.y);
    }
    ctx.strokeStyle = "#ff5a1f";
    ctx.lineWidth = 2.5;
    ctx.setLineDash([6, 3]);
    ctx.stroke();
    ctx.setLineDash([]);

    // Draw 3D Waypoint Markers with vertical stems
    let now = Date.now() * 0.003;
    for (let wp of waypoints) {
      let th = getTerrainHeightAt(wp.gx, wp.gz);
      let groundPt = project3D(wp.gx, th, wp.gz, W, H);
      // Floating marker height above surface
      let stemHeight = 0.22;
      let floatPt = project3D(wp.gx, th + stemHeight, wp.gz, W, H);

      // Vertical elevation stem
      ctx.beginPath();
      ctx.moveTo(groundPt.x, groundPt.y);
      ctx.lineTo(floatPt.x, floatPt.y);
      ctx.strokeStyle = wp.color || "#4edea3";
      ctx.lineWidth = 1.5;
      ctx.setLineDash([2, 2]);
      ctx.stroke();
      ctx.setLineDash([]);

      // Ground anchor point
      ctx.beginPath();
      ctx.arc(groundPt.x, groundPt.y, 3, 0, Math.PI * 2);
      ctx.fillStyle = wp.color || "#4edea3";
      ctx.fill();

      // Floating Marker Pin
      let isActive = activeWp && activeWp.id === wp.id;
      let pulse = wp.isLive ? Math.sin(now * 3) * 3 : 0;
      let r = isActive ? 8 + pulse : 6;

      ctx.beginPath();
      ctx.arc(floatPt.x, floatPt.y, r, 0, Math.PI * 2);
      ctx.fillStyle = wp.color;
      ctx.shadowColor = wp.color;
      ctx.shadowBlur = isActive ? 16 : 8;
      ctx.fill();
      ctx.shadowBlur = 0;

      ctx.strokeStyle = "#08100e";
      ctx.lineWidth = 2;
      ctx.stroke();

      // Label billboard
      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 10px 'JetBrains Mono', monospace";
      ctx.textAlign = "center";
      ctx.fillText(wp.name.split(':')[0], floatPt.x, floatPt.y - 12);
    }

    // Update HUD camera readout
    let pitchDeg = Math.round((pitch * 180) / Math.PI);
    let yawDeg = Math.round((yaw * 180) / Math.PI) % 360;
    const hudAngle = document.getElementById('hud-cam-angle');
    if (hudAngle) {
      hudAngle.textContent = `Pitch: ${pitchDeg}° | Yaw: ${yawDeg}° | Zoom: ${(zoom * 100).toFixed(0)}%`;
    }
  }

  function updateWaypointHUD(wp) {
    if (!wp) return;
    activeWp = wp;
    const titleEl = document.getElementById('wp-title');
    const statusEl = document.getElementById('wp-status');
    const elevEl = document.getElementById('wp-elev');
    const inclineEl = document.getElementById('wp-incline');
    const tempEl = document.getElementById('wp-temp');
    const o2El = document.getElementById('wp-o2');
    const coordsEl = document.getElementById('wp-coords');

    if (titleEl) titleEl.textContent = wp.name;
    if (statusEl) {
      statusEl.textContent = wp.status;
      statusEl.style.color = wp.color;
    }
    if (elevEl) elevEl.textContent = wp.elev;
    if (inclineEl) inclineEl.textContent = wp.incline;
    if (tempEl) tempEl.textContent = wp.temp;
    if (o2El) o2El.textContent = wp.o2;
    if (coordsEl) coordsEl.textContent = `${wp.coords} • Dist: ${wp.dist}`;

    // Highlight button in list
    const wpBtns = document.querySelectorAll('#waypoint-btn-list button');
    wpBtns.forEach((btn) => {
      let id = parseInt(btn.getAttribute('data-wpid'), 10);
      if (id === wp.id) {
        btn.classList.add('border', 'border-primary/50', 'bg-surface-container-high');
      } else {
        btn.classList.remove('border', 'border-primary/50', 'bg-surface-container-high');
      }
    });

    drawTerrain();
  }

  function initTerrainCanvas() {
    if (!canvas) return;
    generateTerrainGrid();

    // Mouse drag orbit controls
    canvas.onmousedown = (e) => {
      isDragging = true;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      autoOrbit = false;
      const orbitBtn = document.getElementById('btn-auto-orbit');
      if (orbitBtn) orbitBtn.classList.remove('text-secondary', 'bg-surface-container-highest');
    };

    window.onmousemove = (e) => {
      if (!isDragging) return;
      let dx = e.clientX - lastMouseX;
      let dy = e.clientY - lastMouseY;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;

      yaw += dx * 0.008;
      pitch = Math.max(0.15, Math.min(1.2, pitch + dy * 0.008));
      drawTerrain();
    };

    window.onmouseup = () => {
      isDragging = false;
    };

    // Mouse wheel zoom
    canvas.onwheel = (e) => {
      e.preventDefault();
      zoom = Math.max(0.5, Math.min(2.4, zoom - e.deltaY * 0.0015));
      drawTerrain();
    };

    // Canvas click to select waypoint
    canvas.onclick = (e) => {
      const rect = canvas.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;

      let closestWp = null;
      let closestDist = 24; // 24px threshold

      for (let wp of waypoints) {
        let th = getTerrainHeightAt(wp.gx, wp.gz);
        let pt = project3D(wp.gx, th + 0.22, wp.gz, canvas.width, canvas.height);
        let d = Math.hypot(clickX - pt.x, clickY - pt.y);
        if (d < closestDist) {
          closestDist = d;
          closestWp = wp;
        }
      }

      if (closestWp) {
        updateWaypointHUD(closestWp);
      }
    };

    // Sidebar waypoint buttons
    const wpBtns = document.querySelectorAll('#waypoint-btn-list button');
    wpBtns.forEach((btn) => {
      btn.onclick = () => {
        let id = parseInt(btn.getAttribute('data-wpid'), 10);
        let found = waypoints.find(w => w.id === id);
        if (found) {
          updateWaypointHUD(found);
        }
      };
    });

    // Sun Slider
    const sunSlider = document.getElementById('slider-sun');
    const sunLabel = document.getElementById('sun-label');
    if (sunSlider) {
      sunSlider.oninput = (e) => {
        let val = e.target.value / 100;
        sunAzimuth = val;
        if (sunLabel) {
          if (val < 0.3) sunLabel.textContent = `Dawn Horizon (${(6 + val * 10).toFixed(0)}:00)`;
          else if (val < 0.7) sunLabel.textContent = `Noon Overhead (${(11 + val * 4).toFixed(0)}:00)`;
          else sunLabel.textContent = `Civil Dusk (19:42)`;
        }
        drawTerrain();
      };
    }

    // Toggle Checkboxes
    const cbWire = document.getElementById('toggle-wireframe');
    const cbShaded = document.getElementById('toggle-shaded');
    const cbContours = document.getElementById('toggle-contours');
    const cbFog = document.getElementById('toggle-fog');

    if (cbWire) cbWire.onchange = (e) => { showWireframe = e.target.checked; drawTerrain(); };
    if (cbShaded) cbShaded.onchange = (e) => { showShaded = e.target.checked; drawTerrain(); };
    if (cbContours) cbContours.onchange = (e) => { showContours = e.target.checked; drawTerrain(); };
    if (cbFog) cbFog.onchange = (e) => { showFog = e.target.checked; drawTerrain(); };

    // Zoom Buttons
    const btnIn = document.getElementById('btn-zoom-in');
    const btnOut = document.getElementById('btn-zoom-out');
    if (btnIn) btnIn.onclick = () => { zoom = Math.min(2.4, zoom + 0.15); drawTerrain(); };
    if (btnOut) btnOut.onclick = () => { zoom = Math.max(0.5, zoom - 0.15); drawTerrain(); };

    // Reset view
    const btnReset = document.getElementById('btn-reset-view');
    if (btnReset) btnReset.onclick = () => {
      yaw = -0.75;
      pitch = 0.55;
      zoom = 1.05;
      drawTerrain();
    };

    // Auto-Orbit toggle
    const btnOrbit = document.getElementById('btn-auto-orbit');
    if (btnOrbit) {
      btnOrbit.onclick = () => {
        autoOrbit = !autoOrbit;
        btnOrbit.classList.toggle('text-secondary', autoOrbit);
        btnOrbit.classList.toggle('bg-surface-container-highest', autoOrbit);
      };
    }

    // Snap to Beacon
    const btnSnap = document.getElementById('btn-snap-beacon');
    if (btnSnap) {
      btnSnap.onclick = () => {
        updateWaypointHUD(waypoints[2]);
        yaw = -0.75;
        pitch = 0.52;
        zoom = 1.25;
        drawTerrain();
      };
    }

    // Export OBJ mock trigger
    const btnExport = document.getElementById('btn-export-mesh');
    if (btnExport) {
      btnExport.onclick = () => {
        btnExport.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">sync</span> Generating .OBJ';
        setTimeout(() => {
          btnExport.innerHTML = '<span class="material-symbols-outlined text-sm text-secondary">check</span> Export Ready';
          setTimeout(() => {
            btnExport.innerHTML = '<span class="material-symbols-outlined text-sm">download</span><span>Export Mesh (.OBJ)</span>';
          }, 2000);
        }, 800);
      };
    }

    // Auto-orbit loop
    function loop() {
      if (!modal3D.classList.contains('hidden')) {
        if (autoOrbit && !isDragging) {
          yaw += 0.0035;
        }
        drawTerrain();
      }
      autoOrbitInterval = requestAnimationFrame(loop);
    }
    if (autoOrbitInterval) cancelAnimationFrame(autoOrbitInterval);
    autoOrbitInterval = requestAnimationFrame(loop);

    updateWaypointHUD(waypoints[2]);
  }
</script></main></div></body></html>